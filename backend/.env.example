# ApostropheCMS Backend Environment Variables
# Copy this file to .env and fill in your values.

# Required for local development when using the Astro frontend
APOS_EXTERNAL_FRONT_KEY=dev

# Signs session cookies. Not needed for local development. Required in
# production (NODE_ENV=production): the server refuses to start without it.
# Use a long random string, for example the output of `openssl rand -hex 32`.
# APOS_SESSION_SECRET=

# Optional REST API key with admin access. Leave unset unless you need one.
# APOS_API_KEY=

# Set to 1 to force the admin UI to rebuild on every nodemon restart.
# Only needed when actively developing Apostrophe admin UI code.
# By default, the admin UI only rebuilds when package-lock.json changes.
# APOS_DEV=1

# Public-facing base URL of the Astro frontend (overrides baseUrl in app.js)
# APOS_BASE_URL=http://localhost:4321

# Base URL used when doing a static Astro build
# APOS_STATIC_BASE_URL=http://static.localhost:4000

# URL path prefix for non-root hosting (e.g. GitHub Pages). No trailing slash.
# APOS_PREFIX=

# Database connection URI. This project defaults to SQLite, configured in
# app.js (defaultAdapter: 'sqlite'). The database file lives at
# backend/data/portfo-rizki.sqlite and no database server is required.
# Uncomment APOS_DB_URI only to override that default.
#
# SQLite (the default; path is resolved from the backend directory):
# APOS_DB_URI=sqlite://./data/portfo-rizki.sqlite
#
# MongoDB:
# APOS_DB_URI=mongodb://localhost:27017/portfo-rizki
#
# PostgreSQL:
# APOS_DB_URI=postgres://user:password@localhost:5432/portfo_rizki
